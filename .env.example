# Ключ: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Токен бота: Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# Сервер, на котором команды должны появиться сразу.
# Без этого Discord раскатывает команды до часа.
DISCORD_GUILD_ID=

# Необязательно: если пусто, id достаётся из токена и ссылка-приглашение строится сама.
DISCORD_CLIENT_ID=

# Канал можно выбрать командой /channel. Число сюда — если хочешь задать его заранее.
NOTIFY_CHANNEL_ID=

# Автоотправка без команд бота.
# Канал → Изменить канал → Интеграции → Вебхуки → скопировать URL.
# Вместе с STEAM_API_KEY и WATCH_STEAM_IDS процесс сам пишет в канал.
# Если бот в сети и канал выбран, вебхук не используется.
DISCORD_WEBHOOK_URL=

# Через запятую: ссылки на профили, vanity или SteamID64.
# Эти друзья добавляются при старте.
WATCH_STEAM_IDS=

# Как часто сверять библиотеки, в секундах. Минимум 60.
POLL_INTERVAL_SECONDS=600

# auto: пример на панели включён, пока не заданы и Steam, и Discord.
# true / false — принудительно.
DEMO_MODE=auto

DATABASE_PATH=./data/steam_ping.db
WEB_HOST=0.0.0.0
WEB_PORT=8741
